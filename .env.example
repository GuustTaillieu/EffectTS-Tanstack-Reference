# Better Auth Server URL (Spotify requires 127.0.0.1 for local OAuth callback, not localhost)
BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace_with_a_secure_random_string_32_chars

# Spotify Developer Application (https://developer.spotify.com/dashboard)
# Whitelist Redirect URI: http://127.0.0.1:5173/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
